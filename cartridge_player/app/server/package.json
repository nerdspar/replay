{
  "name": "cartridge-player-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "dev:fake-ha": "node tools/fake-home-assistant.mjs",
    "dev:against-fake-ha": "SUPERVISOR_TOKEN=fake-token CARTRIDGE_SUPERVISOR_URL=http://127.0.0.1:9123 CARTRIDGE_HA_REST_BASE=http://127.0.0.1:9123/core/api CARTRIDGE_HA_WS_URL=ws://127.0.0.1:9123/core/websocket CARTRIDGE_DB_PATH=./dev-data/cartridge.db CARTRIDGE_WEB_ROOT=../web/dist tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
