# Copy to secrets.yaml in your ESPHome config directory and fill in.
# Generate the API key with: openssl rand -base64 32

wifi_ssid: "your-network"
wifi_password: "your-password"
fallback_ap_password: "cartridge"

cartridge_reader_api_key: "base64-32-byte-key"
cartridge_reader_ota_password: "something-long"
